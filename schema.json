{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://pdaas.com.tr/schema.json",
  "title": "PDAAS Referans Veri Şeması",
  "description": "PDAAS kataloğundaki tüm referans veri dosyalarının uyacağı ortak JSON şeması.",
  "type": "object",

  "required": [
    "surum",
    "kurum",
    "birim",
    "kategori",
    "parametre_adi",
    "aciklama",
    "sorumlu_kurum",
    "kaynak",
    "join_anahtari",
    "zaman_bazli",
    "kayitlar",
    "meta",
    "notlar"
  ],

  "properties": {

    "surum": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}$",
      "description": "Veri sürümü (YYYY.MM.DD formatı)",
      "examples": ["2026.01.01"]
    },

    "kurum": {
      "type": "string",
      "description": "Resmi kurum adı (tam)",
      "examples": ["Sosyal Güvenlik Kurumu (SGK)"]
    },

    "birim": {
      "type": "string",
      "description": "Veriyi yayımlayan alt birim",
      "examples": ["Sigorta Primleri Genel Müdürlüğü"]
    },

    "kategori": {
      "type": "string",
      "description": "Veri kategorisi (snake_case)",
      "examples": ["sosyal", "belge_turu", "işkolu", "vergi"]
    },

    "parametre_adi": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Makine adı (snake_case)",
      "examples": ["asgari_ucret", "prim_oranlari"]
    },

    "aciklama": {
      "type": "string",
      "description": "İnsan okunur kısa açıklama"
    },

    "sorumlu_kurum": {
      "type": "string",
      "description": "Vereden sorumlu resmi kurum"
    },

    "kaynak": {
      "type": "string",
      "description": "Resmi dayanak — Resmî Gazete tarihi/sayısı, Kanun maddesi, Genelge no vb."
    },

    "join_anahtari": {
      "type": "string",
      "description": "Bu dosyanın diğer dosyalarla birleştirilmesinde kullanılacak anahtar alan adı",
      "examples": ["kod", "isco_kodu", "belge_tur_kodu"]
    },

    "zaman_bazli": {
      "type": "boolean",
      "description": "Verinin geçerlilik tarihine bağlı olup olmadığı"
    },

    "yururluk_baslangic": {
      "type": "string",
      "format": "date",
      "description": "Yürürlük başlangıç tarihi (sadece zaman_bazli=true ise zorunlu)"
    },

    "yururluk_bitis": {
      "type": "string",
      "format": "date",
      "description": "Yürürlük bitiş tarihi (sadece zaman_bazli=true ise zorunlu)"
    },

    "kayitlar": {
      "type": "array",
      "description": "Veri kayıtları",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kod", "ad"],
        "properties": {
          "kod": {
            "type": "string",
            "description": "Kod değeri (string)"
          },
          "ad": {
            "type": "string",
            "description": "İnsan okunur ad/açıklama"
          },
          "deger": {
            "type": ["number", "string", "null"],
            "description": "Sayısal/metinsel değer (opsiyonel — oran, tutar, süre vb.)"
          },
          "oran": {
            "type": ["number", "null"],
            "description": "Oran değeri (opsiyonel — %)"
          },
          "birim": {
            "type": ["string", "null"],
            "description": "Ölçü birimi (%, TL, gün, ay)"
          },
          "periyot": {
            "type": ["string", "null"],
            "description": "Periyot (aylik, gunluk, 6_aylik, yillik)",
            "enum": ["gunluk", "haftalik", "aylik", "3_aylik", "6_aylik", "yillik", "sabit", null]
          },
          "ust_kod": {
            "type": ["string", "null"],
            "description": "Üst kod (hiyerarşik yapılar için)"
          },
          "gecerlilik_baslangic": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Kayıt bazlı geçerlilik başlangıcı"
          },
          "gecerlilik_bitis": {
            "type": ["string", "null"],
            "format": "date",
            "description": "Kayıt bazlı geçerlilik bitişi"
          },
          "aciklama": {
            "type": ["string", "null"],
            "description": "Kayıt bazlı uzun açıklama"
          },
          "bilesenler": {
            "type": ["object", "null"],
            "description": "Alt bileşenler (ör. MYÖ, GSS, KVSK)"
          },
          "notlar": {
            "type": ["array", "null"],
            "items": { "type": "string" }
          },
          "meta": {
            "type": ["object", "null"],
            "description": "Kayıt bazlı meta (opsiyonel)"
          }
        }
      }
    },

    "meta": {
      "type": "object",
      "required": ["giris_tarihi", "giren_kurum", "onay_durumu"],
      "properties": {
        "giris_tarihi": {
          "type": "string",
          "format": "date",
          "description": "Verinin sisteme giriş tarihi"
        },
        "giren_kurum": {
          "type": "string",
          "description": "Veriyi giren kurum kısa adı"
        },
        "onay_durumu": {
          "type": "string",
          "enum": ["onaylandi", "beklemede", "reddedildi"],
          "description": "Onay durumu"
        }
      }
    },

    "notlar": {
      "type": "array",
      "description": "Dosya ile ilgili serbest açıklama notları",
      "items": { "type": "string" }
    }
  },

  "allOf": [
    {
      "if": { "properties": { "zaman_bazli": { "const": true } } },
      "then": {
        "required": ["yururluk_baslangic", "yururluk_bitis"]
      }
    }
  ]
}
