{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdaas.com.tr/api/v1/meta/schema/pdaas-meta-1.5.0.json",
  "title": "PDaaS meta bloğu (şema 1.5.0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_surumu", "servis", "yayinci", "katman", "yapi", "surum", "zaman", "kaynaklar", "mevzuat_ref", "yayin_durumu", "checksum", "uretim"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_surumu": { "const": "1.5.0" },
    "servis": {
      "type": "object", "required": ["kod", "ad"],
      "properties": {
        "kod": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "ad": { "type": "object", "required": ["tr"], "properties": { "tr": { "type": "string" }, "en": { "type": ["string", "null"] } } }
      }
    },
    "yayinci": {
      "type": "object", "required": ["kod", "ad", "konsorsiyum", "kurumlar"],
      "properties": {
        "kod": { "type": "string" },
        "ad": { "type": "object", "required": ["tr"] },
        "birim": { "type": ["object", "null"] },
        "konsorsiyum": { "type": "boolean" },
        "kurumlar": { "type": "array", "items": { "type": "string" } }
      }
    },
    "katman": { "enum": ["ham", "konsolide"] },
    "yapi": {
      "type": "object", "required": ["tip", "kod_sistemi", "join", "kapsam"],
      "properties": {
        "tip": { "enum": ["agac", "harita", "liste", "kural-seti"] },
        "kod_sistemi": { "type": "string" },
        "join": { "type": "object" },
        "kapsam": { "type": "array", "items": { "type": "string" } }
      }
    },
    "surum": {
      "type": "object", "required": ["surum", "dosya_surumu", "onceki", "guncelleme"],
      "properties": {
        "surum": { "type": "string" },
        "dosya_surumu": { "type": "string" },
        "onceki": { "type": ["string", "null"] },
        "guncelleme": { "type": "string" }
      }
    },
    "zaman": { "type": "object" },
    "kaynaklar": { "type": "array" },
    "mevzuat_ref": { "type": "array" },
    "yayin_durumu": { "type": "string" },
    "checksum": { "type": "object" },
    "uretim": { "type": ["object", "null"] },
    "parca": { "type": "object" }
  }
}