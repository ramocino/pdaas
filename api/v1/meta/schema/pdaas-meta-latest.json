{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdaas.com.tr/api/v1/meta/schema/pdaas-meta-1.5.0.json",
  "title": "PDaaS meta bloğu",
  "description": "Ham ve konsolide katman dosyalarının meta alanı, şema 1.3.0 (gerçek örnek dosyadan çıkarıldı).",
  "type": "object",
  "required": [
    "$schema",
    "schema_surumu",
    "servis",
    "yayinci",
    "katman",
    "yapi",
    "surum",
    "zaman",
    "kaynaklar",
    "mevzuat_ref",
    "yayin_durumu",
    "checksum",
    "uretim"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_surumu": {
      "const": "1.3.0"
    },
    "servis": {
      "type": "object",
      "required": [
        "kod",
        "ad"
      ],
      "additionalProperties": false,
      "properties": {
        "kod": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "ad": {
          "type": "object",
          "required": [
            "tr",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "tr": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "aciklama": {
          "type": "object",
          "required": [
            "tr",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "tr": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "yayinci": {
      "type": "object",
      "required": [
        "kod",
        "ad",
        "konsorsiyum",
        "kurumlar"
      ],
      "additionalProperties": false,
      "properties": {
        "kod": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "ad": {
          "type": "object",
          "required": [
            "tr",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "tr": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "birim": {
          "type": "object",
          "required": [
            "tr",
            "en"
          ],
          "additionalProperties": false,
          "properties": {
            "tr": {
              "type": "string",
              "minLength": 1
            },
            "en": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "konsorsiyum": {
          "type": "boolean"
        },
        "kurumlar": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        }
      }
    },
    "katman": {
      "enum": [
        "ham",
        "konsolide"
      ]
    },
    "yapi": {
      "type": "object",
      "required": [
        "tip",
        "kod_sistemi",
        "join",
        "kapsam"
      ],
      "additionalProperties": false,
      "properties": {
        "tip": {
          "enum": [
            "agac",
            "liste",
            "kural-seti"
          ]
        },
        "kod_sistemi": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "join": {
          "type": "object",
          "required": [
            "alan",
            "yontem"
          ],
          "additionalProperties": false,
          "properties": {
            "alan": {
              "type": "string"
            },
            "yontem": {
              "enum": [
                "tam",
                "prefix"
              ]
            }
          }
        },
        "kapsam": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "urun",
              "hizmet",
              "faaliyet"
            ]
          }
        }
      }
    },
    "surum": {
      "type": "object",
      "required": [
        "surum",
        "dosya_surumu",
        "onceki",
        "guncelleme"
      ],
      "additionalProperties": false,
      "properties": {
        "surum": {
          "type": "string",
          "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,2}$"
        },
        "dosya_surumu": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "onceki": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "guncelleme": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "zaman": {
      "type": "object",
      "required": [
        "zaman_bazli",
        "gecerlilik_baslangic",
        "gecerlilik_bitis"
      ],
      "additionalProperties": false,
      "properties": {
        "zaman_bazli": {
          "type": "boolean"
        },
        "gecerlilik_baslangic": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "gecerlilik_bitis": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "kaynaklar": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kod",
          "ad",
          "tur",
          "kurum_kod",
          "url",
          "erisim_tarihi"
        ],
        "additionalProperties": false,
        "properties": {
          "kod": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "ad": {
            "type": "object",
            "required": [
              "tr",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "tr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "tur": {
            "type": "string",
            "minLength": 1
          },
          "kurum_kod": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri-reference"
          },
          "erisim_tarihi": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "mevzuat_ref": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tur",
          "ad",
          "karar_sayisi",
          "resmi_gazete"
        ],
        "additionalProperties": false,
        "properties": {
          "tur": {
            "type": "string",
            "minLength": 1
          },
          "ad": {
            "type": "object",
            "required": [
              "tr",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "tr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "karar_sayisi": {
            "type": [
              "string",
              "null"
            ]
          },
          "resmi_gazete": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "yayin_durumu": {
      "enum": [
        "yayinda",
        "taslak",
        "kaldirildi"
      ]
    },
    "checksum": {
      "type": "object",
      "required": [
        "algoritma",
        "deger",
        "kapsam"
      ],
      "additionalProperties": false,
      "properties": {
        "algoritma": {
          "enum": [
            "sha256"
          ]
        },
        "deger": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "kapsam": {
          "enum": [
            "kayitlar",
            "kurallar"
          ]
        }
      }
    },
    "uretim": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "ham_kaynaklar",
            "kural_seti"
          ],
          "additionalProperties": false,
          "properties": {
            "ham_kaynaklar": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "servis",
                  "surum",
                  "checksum"
                ],
                "additionalProperties": false,
                "properties": {
                  "servis": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                  },
                  "surum": {
                    "type": "string",
                    "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,2}$"
                  },
                  "checksum": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            },
            "kural_seti": {
              "type": "object",
              "required": [
                "kod",
                "surum"
              ],
              "additionalProperties": false,
              "properties": {
                "kod": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "surum": {
                  "type": "string",
                  "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,2}$"
                }
              }
            },
            "eslesme_ozeti": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "toplam": {
                  "type": "integer",
                  "minimum": 0
                },
                "eslesen": {
                  "type": "integer",
                  "minimum": 0
                },
                "eslesmeyen": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      ]
    }
  }
}
