{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdaas.com.tr/api/v1/meta/schema/pdaas-katalog-1.0.0.json",
  "title": "PDaaS katalog",
  "type": "object",
  "required": [
    "$schema",
    "api_surumu",
    "olusturma",
    "servisler"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "api_surumu": {
      "const": "v1"
    },
    "olusturma": {
      "type": "string",
      "format": "date-time"
    },
    "servisler": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kod",
          "ad",
          "katmanlar"
        ],
        "additionalProperties": false,
        "properties": {
          "kod": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "ad": {
            "type": "object",
            "required": [
              "tr",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "tr": {
                "type": "string",
                "minLength": 1
              },
              "en": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "katmanlar": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "ham": {
                "type": "object",
                "required": [
                  "son",
                  "url",
                  "surumler_url",
                  "checksum"
                ],
                "additionalProperties": false,
                "properties": {
                  "son": {
                    "type": "string",
                    "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,2}$"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^/api/v1/"
                  },
                  "surumler_url": {
                    "type": "string",
                    "pattern": "^/api/v1/"
                  },
                  "checksum": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              },
              "konsolide": {
                "type": "object",
                "required": [
                  "son",
                  "url",
                  "surumler_url",
                  "checksum"
                ],
                "additionalProperties": false,
                "properties": {
                  "son": {
                    "type": "string",
                    "pattern": "^\\d{4}\\.\\d{1,2}\\.\\d{1,2}$"
                  },
                  "url": {
                    "type": "string",
                    "pattern": "^/api/v1/"
                  },
                  "surumler_url": {
                    "type": "string",
                    "pattern": "^/api/v1/"
                  },
                  "checksum": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
