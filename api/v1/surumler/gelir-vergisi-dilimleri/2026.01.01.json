  "notlar_tr": [
    "Ücret gelirleri için ayrı, diğer gelirler için ayrı tarife uygulanır.",
    "İlk iki dilim (190.000 TL ve 400.000 TL) her iki tarife için ortaktır.",
    "Fark, 3. dilimden itibaren başlar.",
    "Asgari ücret istisnası nedeniyle, asgari ücretli çalışanlar yıl boyunca gelir vergisi ödemez.",
    "kategori='ucret' → ücret gelirleri tarifesi; kategori='diger' → ücret dışı gelirler tarifesi.",
    "matrah_ust_sinir_tl=null → en üst dilim (üst sınır yok).",
    "sabit_vergi_tl → bu dilime kadar olan kısmın toplam vergisi."
  ],
  "notlar_en": [
    "A separate bracket schedule applies to wage income and to other income.",
    "The first two brackets (190,000 TRY and 400,000 TRY) are common to both schedules.",
    "The difference begins from the 3rd bracket onwards.",
    "Due to the minimum wage exemption, minimum-wage employees pay no income tax throughout the year.",
    "kategori='ucret' → wage income schedule; kategori='diger' → non-wage income schedule.",
    "matrah_ust_sinir_tl=null → topmost bracket (no upper limit).",
    "sabit_vergi_tl → cumulative tax on the portion up to this bracket."
  ]
